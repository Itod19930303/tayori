rules_version = '2';
// Firebase Storage セキュリティルール（基本設計書 7.2）。
// Storage からは Firestore の members を直接参照できないため、読み取りは認証済みのみとし、
// メンバー限定アクセスは署名付き downloadUrl の運用で担保する。
// 書き込みは認証済み + ファイルサイズ上限（500MB）で制限する。
service firebase.storage {
  match /b/{bucket}/o {
    match /albums/{albumId}/{mediaId}/{fileName} {
      // 読み: 認証済みのみ
      allow read: if request.auth != null;

      // 書き: 認証済み + 500MB 未満
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024 * 1024;
    }
  }
}
